<% layout('/layouts/boilerplate') -%>

<script>
    window.mapToken = "<%= process.env.MAP_TOKEN %>";
    window.listing = <%- JSON.stringify(listing) %>;
</script>


<div class="row">
    <div class="col-8 offset-1 mt-3">
        <h3> <%= listing.title %> </h3>
    </div>

    <div class="card col-10 offset-1 show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-image" alt="listing_image">
    </div>

    <div class="col-10 offset-1 infos">
        <div class="info-card ">
            <div class="card-body">
                <p><b>Hosted by ~ </b><i><%= listing.owner.username %></i> </p>
                <p class="card-text"><%= listing.description %></p>
                &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
                <%= listing.location %> <br>
                <%= listing.country %> <br>
            </div>
            <br>

            <% if (currUser && listing.owner._id.equals(currUser._id)) { %>

            <div class="btns">
                <form method="GET" action="/listings/<%= listing._id %>/edit">
                    <button class="btn btn-dark edit-btn left-btn">Edit</button>
                </form>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-dark">Delete</button>
                </form>
            </div>
            <% } %>
            <br>
        </div>


        <div class="booking-card">
            <div class="price-tag" style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center;">
                <div style="text-decoration: underline;"><h4>&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></h4></div>
                <div class="mb-0.4"><h6>&nbsp;/ night</h6></div>
            </div>
            <div>
                <form action="#">
                    <div class="mb-3">
                        <label for="guest" class="form-label">Guests</label>
                        <input type="number" name="guest" class="form-control" placeholder="Enter no. of guests">
                    </div>

                    <button class="reserve-btn"><h6>Reserve</h6></button>
                    <div class="booking-text">You won't be charged yet</div>
                </form>
            </div>
        </div>
    </div>
    <hr class="col-11 offset-1">
    <div>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="col-8 offset-2 mt-3">
                <% if(currUser) { %> 
                <h4>Leave a Review</h4>
                <fieldset class="starability-slot">
                    <p>Rating</p>
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
                <br>
                <div>
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" col="30" rows="5" class="form-control" placeholder="Write a review..." required></textarea>
                    <div class="invalid-feedback">Please write a comment for review</div>
                </div>
                <br><br>
                <button class="btn btn-outline-dark">Submit</button>
                <% } %>
                <hr>
            </div>
        </form>

        <p class="offset-2"><b>Reviews</b></p>
        <div class="row offset-lg-2 offset-1 offset-md-2 offset-sm-2">
            <% for(review of listing.reviews) { %>
            <div class="card ms-4 mb-3" id="review-card" style="width: 280px;">
                <div class="card-body pt-2 pb-2 ps-2 pe-2">
                    <h5 class="card-title">@<%= review.author.username %></h5>
                    <p class="starability-result card-text" data-rating="<%= review.rating  %>"></p>
                    <p class="card-text"><%= review.comment  %></p>
                </div>
                <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                    <button class="btn btn-sm btn-dark mb-3" style="width: 4rem;">Delete</button>
                </form>
            </div>
            <% } %>
        </div>
    </div>
    <hr class="col-8 offset-2"> 
    <div class="col-8 mt-3 ">
        <h3>Where you'll be</h3>
        <div id="map"></div>
        <br>
    </div>
</div>


<script src="/js/map.js"></script>