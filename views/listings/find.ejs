<% layout('/layouts/boilerplate') -%>
<div>
    <h3>Search results -</h3>
    <br>
</div>

<% if(allListings.length === 0) { %>
    <h5>No result found :&#40;</h5>
<% } %>

<div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 mt-3">
    <% for(listing of allListings) { %> 
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="listing-image" style="height: 20rem">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %> <br></b>
                        &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
                        <i class="tax-info"> &nbsp;&nbsp; +18% GST</i>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>